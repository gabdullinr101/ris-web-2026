@host = http://localhost:5000

GET {{host}}/health

###

GET {{host}}/info

###

# Без входа - 401
GET {{host}}/api/bookings

###

# Вход администратором - 200, сервер ставит cookie fitness_auth
POST {{host}}/api/auth/login
Content-Type: application/json

{ "login": "admin", "password": "Fitness2026!" }

###

# Создать запись - 201
POST {{host}}/api/bookings
Content-Type: application/json

{
  "title": "Персональная тренировка, силовая",
  "hallId": 2,
  "description": "Клиент новичок, нужна программа на 4 недели"
}

###

# Короткий вид тренировки - 400
POST {{host}}/api/bookings
Content-Type: application/json

{
  "title": "Сил",
  "hallId": 2,
  "description": "Клиент новичок, нужна программа на 4 недели"
}

###

# Несуществующий id - 404
GET {{host}}/api/bookings/999999

###

# Назначить тренера - 200, статус остаётся New
PATCH {{host}}/api/bookings/1/assignee
Content-Type: application/json

{ "assigneeUserId": 2 }

###

# Вход назначенным тренером
POST {{host}}/api/auth/login
Content-Type: application/json

{ "login": "trainer", "password": "Fitness2026!" }

###

# Перевести в работу - 200 (чужая запись - 403, без тренера - 409)
PATCH {{host}}/api/bookings/1/status
Content-Type: application/json

{ "status": "InProgress" }

###

POST {{host}}/api/auth/logout

###
